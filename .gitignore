# ============================================================
# TaskFlow — Root .gitignore
# Bảo vệ thông tin bảo mật và loại trừ file không cần thiết
# ============================================================

# ============================================================
# SECRETS & CREDENTIALS — KHÔNG BAO GIỜ COMMIT
# ============================================================

# Environment variables (chứa passwords, API keys, secrets)
.env
.env.*
!.env.example
!.env.*.example

# Private keys & certificates
*.pem
*.key
*.crt
*.cer
*.p12
*.pfx
*.jks
id_rsa
id_rsa.*
id_ed25519
id_ed25519.*
*.pub

# JWT / OAuth secrets
jwt_secret*
oauth_secret*
client_secret*

# Cloud provider credentials
.aws/
.gcp/
.azure/
credentials.json
service-account*.json
*-service-account.json
gcloud-credentials.json

# API keys & tokens
*.token
api_key*
api-key*
secret_key*

# ============================================================
# BACKEND — Python / Django
# ============================================================

# Virtual environments
.venv/
venv/
env/
ENV/
.python-version

# Python cache
__pycache__/
*.py[cod]
*$py.class
*.pyc
*.pyo
*.pyd

# Django
*.log
local_settings.py
db.sqlite3
db.sqlite3-journal

# Django media uploads (user-generated content)
task-management-backend/media/

# Django static files (generated by collectstatic)
task-management-backend/staticfiles/

# Coverage
.coverage
.coverage.*
coverage.xml
htmlcov/
*.cover

# pytest
.pytest_cache/
.cache/

# mypy
.mypy_cache/
.dmypy.json
dmypy.json

# ============================================================
# FRONTEND — Node.js / Vue / Vite
# ============================================================

# Dependencies
node_modules/
.pnp
.pnp.js

# Build output
dist/
dist-ssr/
build/

# Vite
*.timestamp-*-*.mjs
*.local

# Testing
coverage/
__screenshots__/
/cypress/videos/
/cypress/screenshots/

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# TypeScript
*.tsbuildinfo

# ESLint cache
.eslintcache

# ============================================================
# DOCKER & INFRASTRUCTURE
# ============================================================

# Docker override files (thường chứa local config)
docker-compose.override.yml
docker-compose.local.yml

# Docker volumes data (nếu mount local)
postgres_data/
redis_data/

# SSL certificates (tự ký hoặc Let's Encrypt)
infra/nginx/certs/
infra/nginx/ssl/
infra/certbot/

# ============================================================
# EDITORS & IDEs
# ============================================================

# VS Code (giữ extensions.json)
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json.example

# JetBrains (PyCharm, WebStorm, IntelliJ)
.idea/
*.iml
*.iws
*.ipr

# Vim / Neovim
*.swp
*.swo
*.swn
*~
.netrwhist

# Emacs
\#*\#
.\#*

# Sublime Text
*.sublime-project
*.sublime-workspace

# ============================================================
# OPERATING SYSTEM
# ============================================================

# macOS
.DS_Store
.AppleDouble
.LSOverride
._*
.Spotlight-V100
.Trashes

# Windows
Thumbs.db
Thumbs.db:encryptable
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/
*.lnk

# Linux
.directory

# ============================================================
# KIRO / AI TOOLS
# ============================================================

.kiro/
SKILL.md

# ============================================================
# MISC
# ============================================================

# Backup files
*.bak
*.backup
*.orig
*.tmp
*.temp

# Archive files (thường chứa sensitive data)
*.zip
*.tar
*.tar.gz
*.tgz
*.rar
*.7z

# Database dumps
*.sql
*.dump
*.db

# Terraform (nếu dùng IaC)
*.tfstate
*.tfstate.*
.terraform/
.terraform.lock.hcl
