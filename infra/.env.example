# ============================================================
# TaskFlow Infrastructure — Biến Môi Trường Docker Compose
# Sao chép file này thành .env và điền giá trị thực tế
# KHÔNG commit file .env vào version control
# ============================================================

# ============================================================
# PostgreSQL Database
# ============================================================

# Tên database
POSTGRES_DB=task_management

# Username PostgreSQL
POSTGRES_USER=postgres

# Password PostgreSQL — THAY ĐỔI trong production
POSTGRES_PASSWORD=postgres

# Hostname của PostgreSQL service (không thay đổi khi dùng Docker)
POSTGRES_HOST=db

# Port PostgreSQL (không thay đổi khi dùng Docker)
POSTGRES_PORT=5432

# ============================================================
# Lưu Ý
# ============================================================
#
# 1. File này chỉ chứa biến cho docker-compose (database credentials).
#    Backend và frontend có file .env riêng:
#    - task-management-backend/.env
#    - task-management-frontend/.env
#
# 2. Trong development, giá trị mặc định (postgres/postgres) là đủ.
#
# 3. Trong production:
#    - Dùng password mạnh cho POSTGRES_PASSWORD
#    - Đảm bảo credentials khớp với task-management-backend/.env
#
# 4. Hostname "db" là tên service trong docker-compose, không thay đổi.
#
# ============================================================
